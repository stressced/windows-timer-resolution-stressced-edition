#include <windows.h>

#define IDI_APP                   1
#define IDI_PATREON               2
#define IDI_PATREON_HOVER         3
#define IDI_X                     4
#define IDI_X_HOVER               5
#define IDC_EDIT_MS               1001
#define IDC_BTN_SET               1002
#define IDC_BTN_MAX               1003
#define IDC_BTN_DEFAULT           1004
#define IDC_CHK_APPLY_STARTUP     1005
#define IDC_CHK_TRAY              1006
#define IDC_BTN_REFRESH           1007
#define IDC_BTN_GLOBAL            1008

#define IDC_LBL_SIGNATURE         1010
#define IDC_LBL_CURRENT_VALUE     1012
#define IDC_LBL_MAXIMUM_VALUE     1014
#define IDC_LBL_MINIMUM_VALUE     1016
#define IDC_LBL_GLOBAL_VALUE      1019
#define IDC_LINE1                 1020
#define IDC_LINE2                 1021
#define IDC_BTN_PATREON           1030
#define IDC_BTN_X                 1031

// First icon group in the file = the icon Explorer shows for ResTimer.exe.
// Generated from R.png by gen_icon.ps1.
IDI_APP ICON "restimer.ico"

// Link buttons next to the signature, also from gen_icon.ps1 (rest / hover colour).
IDI_PATREON       ICON "icons/patreon.ico"
IDI_PATREON_HOVER ICON "icons/patreon_hover.ico"
IDI_X             ICON "icons/x.ico"
IDI_X_HOVER       ICON "icons/x_hover.ico"

1 DIALOGEX 0,0,260,160
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "ResTimer"
FONT 9, "Segoe UI"
{
    EDITTEXT IDC_EDIT_MS,        10, 11, 115, 20, ES_MULTILINE | ES_AUTOHSCROLL | ES_CENTER | WS_TABSTOP
    PUSHBUTTON "Set",            IDC_BTN_SET,      135, 10, 115, 20, WS_TABSTOP | BS_OWNERDRAW

    PUSHBUTTON "Max",            IDC_BTN_MAX,      10, 36, 115, 20, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "Default",        IDC_BTN_DEFAULT,  135, 36, 115, 20, WS_TABSTOP | BS_OWNERDRAW

    CONTROL "", IDC_LINE1, "STATIC", SS_LEFT, 10, 64, 240, 1

    CONTROL "Apply at startup",          IDC_CHK_APPLY_STARTUP, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 72, 112, 10
    CONTROL "Minimize to system tray",   IDC_CHK_TRAY,          "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 84, 112, 10

    PUSHBUTTON "Refresh",        IDC_BTN_REFRESH,  135, 73, 115, 20, WS_TABSTOP | BS_OWNERDRAW

    CONTROL "", IDC_LINE2, "STATIC", SS_LEFT, 10, 98, 240, 1

    LTEXT "current: --   requested: --", IDC_LBL_CURRENT_VALUE, 10, 106, 240, 10, SS_LEFT
    LTEXT "maximum: --", IDC_LBL_MAXIMUM_VALUE, 10, 116, 120, 10, SS_LEFT
    LTEXT "minimum: --", IDC_LBL_MINIMUM_VALUE, 10, 126, 120, 10, SS_LEFT
    LTEXT "global mode: --", IDC_LBL_GLOBAL_VALUE, 10, 136, 120, 10, SS_LEFT

    PUSHBUTTON "Enable global",  IDC_BTN_GLOBAL,   135, 116, 115, 20, WS_TABSTOP | BS_OWNERDRAW

    // The two link buttons are moved at runtime to sit just left of the
    // right-aligned signature text (LayoutSignature), whatever its width.
    PUSHBUTTON "Patreon",        IDC_BTN_PATREON,  150, 138, 12, 12, WS_TABSTOP | BS_OWNERDRAW
    PUSHBUTTON "X",              IDC_BTN_X,        163, 138, 12, 12, WS_TABSTOP | BS_OWNERDRAW
    LTEXT "Stressced Software", IDC_LBL_SIGNATURE, 160, 140, 90, 10, SS_RIGHT | SS_NOPREFIX
}

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Stressced Software"
            VALUE "FileDescription",  "ResTimer - Windows timer resolution"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ResTimer"
            VALUE "LegalCopyright",   "Public Domain"
            VALUE "OriginalFilename", "ResTimer.exe"
            VALUE "ProductName",      "ResTimer"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

1 24 "app.manifest"
